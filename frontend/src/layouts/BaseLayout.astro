---
import SEO from '../components/SEO.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  jsonLd?: object;
}

const { title, description, ogImage, jsonLd } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEO
      title={title}
      description={description}
      ogImage={ogImage}
      jsonLd={jsonLd}
    />
  </head>
  <body>
    <slot />
  </body>
</html>
