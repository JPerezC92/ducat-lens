{
  "eval_id": 1,
  "eval_name": "novel-task-scaffold",
  "prompt": "Scaffold a runbook for task-id feature-009-recommendation-engine (module: ml.recommender, no matching prior art). Apply task-runbook skill end-to-end.",
  "assertions": [
    {
      "text": "finding.md exists at outputs root",
      "check_type": "file_exists",
      "path": "outputs/finding.md"
    },
    {
      "text": "finding.md contains verdict: replay-no",
      "check_type": "file_contains",
      "path": "outputs/finding.md",
      "pattern": "replay-no"
    },
    {
      "text": "finding.md indicates no prior-art match",
      "check_type": "file_contains",
      "path": "outputs/finding.md",
      "pattern": "(?i)none|no match|no prior"
    },
    {
      "text": "runbook.md scaffolded for task",
      "check_type": "file_exists",
      "path": "outputs/tasks/feature-009-recommendation-engine/runbook/runbook.md"
    },
    {
      "text": "at least one phase file copied from template",
      "check_type": "glob_exists",
      "pattern": "outputs/tasks/feature-009-recommendation-engine/runbook/phase-*.md"
    },
    {
      "text": "validator was invoked or finding reports pass",
      "check_type": "any_of",
      "options": [
        {"check_type": "file_exists", "path": "outputs/validator-output.txt"},
        {"check_type": "file_contains", "path": "outputs/finding.md", "pattern": "(?i)validator:\\s*pass"}
      ]
    }
  ]
}
